{% extends "_social_base.html.j2" %}
{% block title %}Team Challenges · {{ week_of.strftime('%b %-d') }}{% endblock %}
{% block styles %}
  /* ON THE DESIGN LANGUAGE (frontend/DESIGN.md): FLAT SILVER PAGE, PINSTRIPES AT THE TOP ONLY. */
  :root { --sheet-background: var(--background-primary); }

  .hero { grid-template-columns: 1fr 540px; align-items: center; }
  .eyebrow { font-family: 'ShowdownSetItalic', "Helvetica Neue", sans-serif; font-style: italic; font-weight: 400; font-size: 15px; letter-spacing: .42em; color: var(--text-tertiary); }
  h1 { margin-top: 14px; font-family: 'ShowdownSetItalic', "Helvetica Neue", sans-serif; font-style: italic; font-weight: 400; font-size: 64px; letter-spacing: 0; color: var(--text-primary); }
  .sub { color: var(--text-secondary); font-size: 17px; line-height: 1.4; margin-top: 12px; }
  .status { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }

  /* THE FANNED STACK - EACH CARD'S ROTATION/OFFSET COMES INLINE FROM ITS POSITION IN THE FAN. */
  .stack { position: relative; height: 440px; }
  /* NUDGED A LITTLE RIGHT OF CENTER SO THE LEFT CARD'S TILT CLEARS THE HERO TEXT. */
  .stack .card { position: absolute; left: 50%; top: 14px; width: 230px; aspect-ratio: 5 / 7; margin-left: -105px; transform-origin: 50% 85%; }
  .stack .card.labels { z-index: 20 !important; }
  /* THE CARDS FLOAT OVER THE PAGE, SO THEY TAKE THE OVERLAY SHADOW (THE ONLY SOFT ONE). */
  .stack .card img { display: block; width: 100%; border-radius: 10px; box-shadow: var(--shadow-overlay); }
  /* A RAISED TAG UNDER EACH CARD: THE PLAYER IN THE CARD-NAME FACE, THE CHALLENGE IN ITS CATEGORY COLOR. */
  .tag { position: absolute; left: 50%; bottom: -14px; transform: translateX(-50%); white-space: nowrap; background: var(--background-secondary); border: 1px solid var(--divider); border-top: 3px solid var(--accent); border-radius: 2px; padding: 6px 12px 7px; box-shadow: var(--shadow-raised); text-align: center; }
  /* TAGS ARE WIDER THAN THE FAN'S SPACING, SO EVERY OTHER ONE SITS HIGHER TO CLEAR ITS NEIGHBORS. */
  .card.raised .tag { bottom: 44px; }
  .tag .who { font-size: 18px; line-height: 1; color: var(--text-primary); }
  .tag .for { color: var(--accent); margin-top: 4px; font-size: 10px; }

  /* MIRRORS THE FRONTEND'S `ChallengeCard`: CATEGORY-COLOR LEFT EDGE WITH A FOLDED CORNER RIBBON. */
  .challenges { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .challenge { position: relative; overflow: hidden; background: var(--background-secondary); border: 1px solid var(--divider); border-left: 5px solid var(--accent); border-radius: 5px; padding: 18px 22px 16px; display: flex; flex-direction: column; }
  .challenge::before { content: ''; position: absolute; left: 0; top: 0; width: 28px; height: 28px; background: var(--accent); clip-path: polygon(0 0, 100% 0, 0 100%); }
  .challenge .cat { align-self: flex-start; color: var(--accent); background: color-mix(in srgb, var(--accent) 15%, transparent); font-size: 12px; }
  .challenge .name { font-size: 34px; line-height: 1.02; color: var(--text-primary); margin-top: 10px; }
  .challenge .desc { color: var(--text-secondary); font-size: 16px; line-height: 1.4; margin-top: 8px; }
  .facts { margin-top: auto; padding-top: 10px; }
  .fact { display: grid; grid-template-columns: 86px 1fr; gap: 10px; align-items: baseline; padding: 9px 0; border-top: 1px solid var(--divider); font-size: 16px; }
  .fact .v { font-weight: 600; color: var(--text-primary); }
  .fact .v .plate { vertical-align: 1px; }
  .rules { display: flex; flex-wrap: wrap; gap: 6px; }
  .rules .plate { white-space: normal; line-height: 1.2; font-size: 12px; }

  footer { border-top-color: var(--divider); color: var(--text-tertiary); }
  footer .url { color: var(--showdown-red); font-size: 24px; }
  footer strong { font-weight: 700; }
{% endblock %}
{% block sheets %}
<div class="sheet">
<div class="pinstripes" aria-hidden="true"></div>
<div class="inner">
<div class="sheet-content">

  <div class="hero">
    <div>
      <img class="logo" src="{{ logo_src }}" alt="Showdown Bot">
      <div class="eyebrow">Team Challenges</div>
      <h1>{{ headline }}</h1>
      <div class="sub">{{ subhead }}</div>
      <div class="status">
        <span class="plate lg navy">{{ challenges|length }} live</span>
        <span class="plate lg outline">{{ week_of.strftime('%b %-d') }}{% if expires_at %} – {{ expires_at.strftime('%b %-d') }}{% else %} week{% endif %}</span>
      </div>
    </div>
    {% if cards %}
    <div class="stack">
      {# TWO PASSES OVER THE SAME FAN POSITIONS: THE CARD ART (MIDDLE CARD ON TOP), THEN THE
         TAGS IN A LAYER ABOVE EVERY CARD SO A NEIGHBOR NEVER COVERS ONE. #}
      {% set mid = (cards|length - 1) / 2 %}
      {% for layer in ('art', 'labels') %}
      {% for k in cards %}
      {% set step = loop.index0 - mid %}
      <div class="card {{ layer }}{{ ' raised' if loop.index0 is odd }}" style="--accent: {{ k.challenge.accent if k.challenge else 'var(--showdown-blue)' }}; transform: translate({{ step * 140 }}px, {{ (step|abs) * 26 }}px) rotate({{ step * 11 }}deg); z-index: {{ 10 - (step|abs * 2)|int }}">
        {% if layer == 'art' %}
        <img src="{{ k.image_src }}" alt="{{ k.name }} {{ k.year }} card">
        {% else %}
        <div class="tag">
          <div class="who upright">{{ k.name }}</div>
          {% if k.challenge %}<div class="for caps-label">{{ k.challenge.title }}</div>{% endif %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <section class="challenges">
    {% for c in challenges %}
    <div class="challenge" style="--accent: {{ c.accent }}">
      <span class="plate cat">{{ c.category_label }} · {{ c.year }}</span>
      <div class="name display">{{ c.title }}</div>
      <div class="desc">{{ c.description }}</div>
      <div class="facts">
        <div class="fact"><div class="caps-label">Take over</div><div class="v">{{ c.takeover_label }}</div></div>
        <div class="fact"><div class="caps-label">Goal</div><div class="v">{{ c.goal_label }}</div></div>
        <div class="fact"><div class="caps-label">Budget</div><div class="v"><span class="plate">{{ '{:,}'.format(c.pts_limit) ~ ' PT.' if c.pts_limit else 'No cap' }}</span> · {{ c.roster_size }}-man roster</div></div>
        {% if c.restrictions %}
        <div class="fact"><div class="caps-label">Rules</div><div class="v rules">{% for r in c.restrictions %}<span class="plate outline">{{ r }}</span>{% endfor %}</div></div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </section>

</div>

  <footer>
    <div class="url display">Draft it. Sim it. Beat it.</div>
    <div><strong>showdownbot.com/teams/challenges</strong></div>
  </footer>

</div>
</div>
{% endblock %}
