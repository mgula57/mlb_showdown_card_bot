<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1080">
<title>{% block title %}{% endblock %}</title>
<style>
  @font-face {
    font-family: 'ShowdownSetItalic';
    src: url('{{ font_src }}') format('opentype');
    font-weight: 400;
    font-style: italic;
  }
  @font-face {
    font-family: 'ShowdownTitle';
    src: url('{{ title_font_src }}') format('opentype');
    font-weight: 900;
    font-style: normal;
  }
  @font-face {
    font-family: 'ShowdownUpright';
    src: url('{{ upright_font_src }}') format('truetype');
    font-weight: 400 900;
    font-style: normal;
  }
  {% if body_font_src %}
  @font-face {
    font-family: 'ShowdownBody';
    src: url('{{ body_font_src }}') format('woff2');
    font-weight: 100 900;
    font-style: normal;
  }
  {% endif %}
  /* MIRRORS THE FRONTEND'S LIGHT-THEME TOKENS (frontend/src/index.css :root). */
  :root {
    --primary: #101317;
    --secondary: #2a2f36;
    --text-primary: var(--primary);
    --text-secondary: var(--secondary);
    --text-tertiary: #646c77;
    --showdown-blue: #1a3b5f;
    --showdown-red: #b3342b;
    --showdown-gray: #6e6e73;
    --background-primary: #eef0f3;
    --background-secondary: #ffffff;
    --background-tertiary: #e2e6ea;
    --divider: #d3d8de;
    --rule-strong: #9aa3ad;
    --plate: #d6dbe1;
    --plate-ink: #101317;
    --stripe: rgb(26 59 95 / 0.07);
    --challenge-legendary: #c8962b;
    --challenge-budget: #2f6bd6;
    --challenge-superteam: #7c4dd0;
    --challenge-themed: #e0654f;
    --shadow-raised: 0 2px 0 var(--rule-strong);
    --shadow-overlay: 0 12px 32px rgb(0 0 0 / 0.18);
    --background-gradient: linear-gradient(to bottom right, rgb(235, 232, 227), rgb(253, 252, 250), rgb(228, 222, 214));
    /* WHAT EACH SHEET SITS ON. A TEMPLATE ON THE DESIGN LANGUAGE SETS IT TO THE FLAT
       `--background-primary` (DESIGN.md: NO DECORATIVE GRADIENTS). */
    --sheet-background: var(--background-gradient);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--background-primary); color: var(--primary);
    font-family: 'ShowdownBody', ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-feature-settings: 'cv05', 'cv08';
  }
  .page { width: 1080px; margin: 0 auto; background: var(--sheet-background); }
  .stripe { height: 10px; background: linear-gradient(115deg, #3b82f6, var(--showdown-blue), var(--showdown-red), #ef4444); }
  .inner { padding: 44px 56px 36px; }
  .display { font-family: 'ShowdownSetItalic', "Helvetica Neue", sans-serif; font-style: italic; text-transform: uppercase; }

  .hero { display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: end; padding-bottom: 28px; border-bottom: 1px solid var(--divider); }
  .logo { display: block; height: 46px; width: auto; margin-bottom: 22px; }
  .eyebrow { color: var(--showdown-red); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  h1 { margin: 18px 0 0; font-family: 'ShowdownTitle', "Helvetica Neue", sans-serif; font-weight: 900; font-size: 60px; line-height: 1; letter-spacing: -.01em; text-transform: uppercase; color: var(--showdown-blue); }
  .sub { color: var(--showdown-gray); font-size: 17px; margin-top: 10px; }

  section { margin-top: 30px; }
  h2 { margin: 0 0 12px; font-size: 20px; font-weight: 900; text-transform: uppercase; color: var(--secondary); }
  h2 small { font-size: 12px; font-weight: 700; letter-spacing: .06em; color: var(--showdown-gray); margin-left: 8px; }
  .panel { background: var(--background-secondary); border: 1px solid var(--divider); border-radius: 12px; padding: 16px 20px; }

  /* DESIGN-LANGUAGE PRIMITIVES (frontend/DESIGN.md), SCALED UP FOR A 1080px SLIDE. */
  .upright { font-family: 'ShowdownUpright', "Helvetica Neue", sans-serif; text-transform: uppercase; }
  .caps-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--text-tertiary); }
  /* `Plate`: THE CARD-FRONT STAT BOX - 2px CORNER, SEMIBOLD BODY-FACE CAPS, TABULAR FIGURES. */
  .plate { display: inline-flex; align-items: center; gap: 6px; border-radius: 2px; padding: 5px 8px; font-size: 14px; font-weight: 600; line-height: 1; text-transform: uppercase; white-space: nowrap; font-variant-numeric: tabular-nums; background: var(--plate); color: var(--plate-ink); }
  .plate.lg { padding: 8px 12px; font-size: 20px; }
  .plate.navy { background: var(--showdown-blue); color: #fff; }
  .plate.outline { background: none; color: var(--text-secondary); box-shadow: inset 0 0 0 1.5px var(--text-tertiary); }
  /* `PinstripeBackdrop`: CARD-BACK PINSTRIPES BEHIND THE TOP OF A SHEET, FADING INTO THE CONTENT. */
  .sheet { position: relative; isolation: isolate; }
  .pinstripes {
    position: absolute; inset: 0 0 auto; height: 720px; z-index: -1; pointer-events: none;
    background-image: repeating-linear-gradient(90deg, var(--stripe) 0 1px, transparent 1px 12px);
    -webkit-mask-image: linear-gradient(to bottom, black 40%, transparent); mask-image: linear-gradient(to bottom, black 40%, transparent);
  }

  footer { margin-top: 32px; display: flex; justify-content: space-between; align-items: center; color: var(--showdown-gray); font-size: 13px; border-top: 1px solid var(--divider); padding-top: 16px; }
  footer strong { color: var(--showdown-blue); font-weight: 900; }
{% block styles %}{% endblock %}
  /* SHEETS. IN THE NORMAL VIEW THEY READ AS ONE CONTINUOUS PAGE. OPENED AS `page.html#pdf`
     (WHICH IS WHAT THE PDF EXPORT PRINTS) EACH SHEET BECOMES A FIXED 1080x1350 (4:5 PORTRAIT,
     INSTAGRAM'S TALLEST FEED SIZE) SLIDE - ONE PDF PAGE / CAROUSEL SLIDE APIECE. */
  .pdf-only { display: none; }
  .sheet + .sheet > .inner { padding-top: 0; }
  .sheet-content > :first-child { margin-top: 0; }
  .sheet-header { justify-content: space-between; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--divider); }
  .sheet-header .logo { height: 34px; margin: 0; }

  html.pdf body { background: var(--background-tertiary); }
  html.pdf .page { width: auto; background: none; }
  html.pdf .sheet {
    width: 1080px; height: 1350px; margin: 0 auto 24px; overflow: hidden; background: var(--sheet-background);
    display: flex; flex-direction: column; break-after: page;
  }
  html.pdf .sheet:last-child { break-after: auto; }
  html.pdf .sheet > .inner { flex: 1; min-height: 0; display: flex; flex-direction: column; padding-top: 40px; }
  html.pdf .sheet-content { flex: none; }
  html.pdf .pdf-only { display: block; }
  html.pdf .sheet-header { display: flex; }
  html.pdf footer { margin-top: auto; }

  @page { size: 1080px 1350px; margin: 0; }
  @media print {
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    html.pdf body { background: none; }
    html.pdf .sheet { margin: 0; }
  }
</style>
</head>
<body>
<div class="page">
{% block sheets %}{% endblock %}
</div>

<script>
  // SLIDE MODE (`#pdf`, OR `#pdf-N` FOR A SINGLE-SHEET IMAGE EXPORT - SEE
  // `SocialSheetReport.write_images`): `#pdf-N` HIDES EVERY SHEET BUT THE NTH, SO A HEADLESS
  // SCREENSHOT AT 1080x1350 CAPTURES EXACTLY THAT ONE. ANY SHEET WHOSE CONTENT RUNS PAST ITS
  // 1350px PAGE IS ZOOMED DOWN JUST ENOUGH TO FIT, SO NOTHING GETS CLIPPED.
  (function () {
    var match = /^#pdf(?:-(\d+))?$/.exec(location.hash);
    if (!match) return;
    document.documentElement.classList.add('pdf');
    if (match[1]) {
      document.querySelectorAll('.sheet').forEach(function (sheet, index) {
        if (index + 1 !== Number(match[1])) sheet.style.display = 'none';
      });
    }
    function fit() {
      document.querySelectorAll('.sheet > .inner').forEach(function (inner) {
        if (getComputedStyle(inner.closest('.sheet')).display === 'none') return;
        var content = inner.querySelector('.sheet-content');
        var footer = inner.querySelector('footer');
        var style = getComputedStyle(inner);
        var available = inner.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom)
          - (footer ? footer.offsetHeight + 24 : 0);
        content.style.zoom = '';
        var needed = content.scrollHeight;
        if (needed > available) content.style.zoom = (available / needed).toFixed(4);
      });
    }
    // WAIT ON IMAGES TOO (CARD ART) - THEIR HEIGHT FEEDS THE FIT MATH.
    var images = Array.prototype.map.call(document.images, function (img) {
      return img.complete ? null : new Promise(function (resolve) { img.onload = img.onerror = resolve; });
    });
    Promise.all([document.fonts.ready].concat(images)).then(fit);
  })();
</script>
</body>
</html>
